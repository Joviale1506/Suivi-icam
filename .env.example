# Mot de passe du site (obligatoire en production)
APP_PASSWORD=
# Secret de signature des sessions (facultatif : dérivé d'APP_PASSWORD sinon)
SESSION_SECRET=
# Lien iCal HyperPlanning (secret, jamais envoyé au navigateur)
ICAL_URL=
# Identifiant de l'utilisateur (clés Redis user:<id>:*)
APP_USER_ID=jo
# Upstash Redis (ajoutées automatiquement par l'intégration Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
